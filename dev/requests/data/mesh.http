# Mesh

# By key

# Only node
POST http://localhost:8010/api/data/mesh
Content-Type: application/json

{
    "entryFilters": [
        {
            "attribute": "start",
            "operator": "GREATER_THAN",
            "value": "0032-04-28"
        },
        {
            "labels": ["Territory","Person"]
        }
    ]
}

###

# With relations of any type
POST http://localhost:8010/api/data/mesh
Content-Type: application/json

{
    "entryFilters": [
        {
            "attribute": "key",
            "operator": "EQUAL",
            "value": "vespasian"
        }
    ],
    "relationFilters": [
        {
            "types": ["*"]
        }
    ]
}

###

# With relations of type 'RELATIONSHIP_WITH' or 'CHILD_OF'
# -> "Vespasian's family"
POST http://localhost:8010/api/data/mesh
Content-Type: application/json

{
    "entryFilters": [
        {
            "attribute": "key",
            "operator": "EQUAL",
            "value": "vespasian"
        }
    ],
    "relationFilters": [
        {
            "types": ["RELATIONSHIP_WITH","CHILD_OF"]
        }
    ]
}


###

# With relations of type 'RELATIONSHIP_WITH' and status 'married'
# -> "Vespasian and his wifes"
POST http://localhost:8010/api/data/mesh
Content-Type: application/json

{
    "entryFilters": [
        {
            "attribute": "key",
            "operator": "EQUAL",
            "value": "vespasian"
        }
    ],
    "relationFilters": [
        {
            "types": ["RELATIONSHIP_WITH"],
            "attribute": "status",
            "operator": "EQUAL",
            "value": "married"
        }
    ]
}

###

# With relations of type 'RULED' and title = 'king'
# -> "All kings / persons that ruled as 'king'"
POST http://localhost:8010/api/data/mesh
Content-Type: application/json

{
    "entryFilters": [
        {
            "labels": ["Person"]
        }
    ],
    "relationFilters": [
        {
            "types": ["RULED"],
            "attribute": "titles",
            "operator": "CONTAINS",
            "value": "king"
        }
    ]
}

###

# With relations of type 'RULED' and title = 'king'
# -> "To which Persons was Vespasian connected?"
POST http://localhost:8010/api/data/mesh
Content-Type: application/json

{
    "entryFilters": [
        {
            "attribute": "key",
            "operator": "EQUAL",
            "value": "vespasian"
        }
    ],
    "relationFilters": [
        {
            "targetEntryFilters": [
                {
                    "labels": ["Person"]
                }
            ]
        }
    ]
}

