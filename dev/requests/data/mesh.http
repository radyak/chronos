# Mesh

# By key

# Only node
POST http://localhost:8010/api/data/mesh
Content-Type: application/json

{
    "entryFilters": [
        {
            "attribute": "start",
            "operator": "GREATER_THAN",
            "value": "0032-04-28"
        },
        {
            "labels": ["Territory","Person"]
        }
    ]
}

###

# With relations of any type
POST http://localhost:8010/api/data/mesh
Content-Type: application/json

{
    "entryFilters": [
        {
            "attribute": "key",
            "operator": "EQUAL",
            "value": "vespasian"
        }
    ],
    "relationFilters": ["*"]
}

###

# With relations of type 'RELATIONSHIP_WITH' or 'CHILD_OF'
POST http://localhost:8010/api/data/mesh
Content-Type: application/json

{
    "filters": [
        {
            "attribute": "key",
            "operator": "EQUAL",
            "value": "vespasian"
        }
    ],
    "relationFilters": ["RELATIONSHIP_WITH","CHILD_OF"]
}

