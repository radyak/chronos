# Get all (default: first 10 elements, no sorting)
GET http://localhost:8010/api/data

###

# Paging example)
GET http://localhost:8010/api/data?pageSize=5&page=2

### 

# Sorting example
GET http://localhost:8010/api/data?sortBy=from&sortOrder=ASC


###

# Statistics
GET http://localhost:8010/api/data/statistics

###

# By ID
GET http://localhost:8010/api/data/vespasian

###

# By ID, with relations/"context"
GET http://localhost:8010/api/data/titus/context


### 

# Filter example: Entries before 200 AD with wikipedia QID
GET http://localhost:8010/api/data?sortBy=from&pageSize=5&from:gt=0032-04-28


### 

# Filter example: First random Entry with wikipedia QID
GET http://localhost:8010/api/data?wikiqid:not=null&sortBy=random


