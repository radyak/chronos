{
  "name": "chronos-frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "node ci/update-version.js && ng serve --configuration production",
    "start:dev": "node ci/update-version.js && ng serve --configuration development",
    "start:mock": "node ci/update-version.js && ng serve --configuration mock --proxy-config proxy.conf.json",
    "prebuild": "node ci/update-version.js",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^20.3.18",
    "@angular/cdk": "^19.2.19",
    "@angular/common": "^20.3.18",
    "@angular/compiler": "^20.3.18",
    "@angular/core": "^20.3.18",
    "@angular/forms": "^20.3.18",
    "@angular/platform-browser": "^20.3.18",
    "@angular/platform-browser-dynamic": "^20.3.18",
    "@angular/router": "^20.3.18",
    "@fortawesome/angular-fontawesome": "^2.0.1",
    "@fortawesome/fontawesome-svg-core": "^6.2.1",
    "@fortawesome/free-solid-svg-icons": "^6.7.2",
    "@ng-bootstrap/ng-bootstrap": "^19.0.1",
    "@popperjs/core": "^2.11.6",
    "angular-oauth2-oidc": "^17.0.1",
    "bootstrap": "^5.2.3",
    "bootswatch": "^5.3.2",
    "ngx-colors": "^3.5.2",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular/build": "^20.3.21",
    "@angular/cli": "~20.3.21",
    "@angular/compiler-cli": "^20.3.18",
    "@angular/localize": "^20.3.18",
    "@types/jasmine": "~4.3.0",
    "jasmine-core": "~4.5.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.1.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.0.0",
    "typescript": "~5.8.3"
  }
}